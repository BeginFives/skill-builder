{
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/{{LANG}}-fmt.sh\"" },
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/{{LANG}}-gate.sh\"" }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/{{LANG}}-full-gate.sh\"" }
      ]
    }
  ]
}
